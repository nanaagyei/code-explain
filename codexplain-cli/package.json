{
  "name": "codexplain-cli",
  "version": "0.1.0",
  "description": "CLI for CodeXplain - analyze repos, files, changelogs, and more.",
  "bin": {
    "codexplain": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codexplain/codexplain-cli"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p ./",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.cjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
